# Copia in .env e compila. .env non va MAI nel repository.

# --- Database ---
# File SQLite del server da solo (pnpm dev). L'app desktop usa il suo, nella cartella dei dati.
DATABASE_PATH=data/prisma.db
# Solo per copiare una volta i dati dal vecchio MySQL (pnpm --filter @prisma-app/server db:import-mysql)
# DATABASE_URL=mysql://prisma:CHANGE_ME@localhost:3306/prisma

# --- Server ---
PORT=4000
# Token API personale usato dal desktop (genera con: openssl rand -hex 32)
API_TOKEN=
# Scheduler di pubblicazione (polling del DB)
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=5000
# Chiave AES-256-GCM per cifrare i token OAuth: 32 byte in base64 (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# --- LLM (DeepSeek, API compatibile OpenAI) ---
# Facoltativo: il servizio AI si sceglie in Impostazioni › AI. Questi valori servono solo da
# ripiego finché lì non c'è nulla.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Le credenziali delle piattaforme e di R2 qui sotto sono facoltative: nell'app si inseriscono in
# Impostazioni › Account (vincono su queste).
# --- LinkedIn OAuth ---
# App su https://www.linkedin.com/developers con i prodotti "Share on LinkedIn" e
# "Sign in with LinkedIn using OpenID Connect"; aggiungere LINKEDIN_REDIRECT_URI tra gli URL autorizzati.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/oauth/linkedin/callback
# Versione API REST di LinkedIn (YYYYMM), supportata almeno un anno dal rilascio
LINKEDIN_API_VERSION=202611

# --- Instagram (Business Login for Instagram, account professionale) ---
# App di tipo Business su developers.facebook.com > Instagram > API setup with Instagram login:
# Instagram App ID e App Secret; aggiungere INSTAGRAM_REDIRECT_URI tra gli OAuth redirect URI.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/oauth/instagram/callback
INSTAGRAM_API_VERSION=v27.0

# --- Metriche (fase 4) ---
# Raccolta delle statistiche di post e account: un giro ogni ora.
ANALYTICS_ENABLED=true
ANALYTICS_POLL_MS=3600000

# --- YouTube (YouTube Data API v3) ---
# Google Cloud Console: abilitare "YouTube Data API v3", schermata di consenso OAuth di tipo
# External, credenziale "OAuth client ID" di tipo Web application con YOUTUBE_REDIRECT_URI tra gli
# Authorized redirect URIs. Mettere l'app "In production": in "Testing" il refresh token scade
# dopo 7 giorni (senza verifica Google mostra l'avviso "app non verificata", da accettare).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/oauth/youtube/callback
# Per le metriche abilitare anche "YouTube Analytics API" nello stesso progetto.
# Categoria dei video (28 = Scienza e tecnologia)
YOUTUBE_CATEGORY_ID=28

# --- TikTok (Login Kit + Content Posting API, caricamento nella casella dell'app) ---
# developers.tiktok.com > app con i prodotti "Login Kit" e "Content Posting API" (scope
# user.info.basic e video.upload): Client key e Client secret. Il redirect URI dev'essere https
# e registrato nell'app (in locale serve un tunnel https verso la porta del server).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost:4000/oauth/tiktok/callback

# --- Cloudflare R2 (file finali da pubblicare) ---
# R2 > Manage API tokens > token "Object Read & Write" limitato al bucket: Access Key ID e Secret.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Indirizzo pubblico del bucket (dominio personalizzato; r2.dev è limitato e solo per prove).
# Serve per Instagram, che scarica le immagini da un URL pubblico. Senza "/" finale.
R2_PUBLIC_BASE_URL=
# Solo per bucket con giurisdizione (EU, FedRAMP): https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
