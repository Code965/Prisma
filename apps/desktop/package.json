{
  "name": "@prisma-app/desktop",
  "productName": "Prisma",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Prisma · social studio: dall'idea ai post per LinkedIn, Instagram, TikTok, YouTube e blog",
  "author": "Code965",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "pnpm --filter @prisma-app/server embed && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@prisma-app/server": "workspace:*",
    "@prisma-app/shared": "workspace:*",
    "@prisma-app/templates": "workspace:*",
    "@tanstack/react-query": "^5.108.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "main": "out/main/index.js"
}
