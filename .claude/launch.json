{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--filter", "@prisma-app/desktop", "dev:web"],
      "port": 5174
    },
    {
      "name": "server",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set DATABASE_PATH=%TEMP%\\prisma-prova\\prisma.db&& pnpm.cmd dev"],
      "port": 4000
    }
  ]
}
